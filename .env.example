# ==============================================================================
# GustavoIA - Sistema de Garagem & Estacionamento
# Template de Variáveis de Ambiente
# ==============================================================================

# --- Backend (Node.js / Express / Mongoose) ---
PORT=3000
NODE_ENV=production

# URI do MongoDB Atlas (Necessário configurar nas Environment Variables da Vercel)
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/?appName=Cluster0

# --- Frontend (React / Vite) ---
# Em produção na Vercel (mesmo domínio), deixe vazio ou use '/api'
# Localmente para desenvolvimento: http://localhost:3000/api
VITE_API_URL=/api
